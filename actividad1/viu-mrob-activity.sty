\newcounter{interviewturn}

\NewDocumentEnvironment{interviewtranscript}{O{Registro de entrevista}}{%
  \setcounter{interviewturn}{0}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=white,
    colframe=UniMuted!45,
    boxrule=0.55pt,
    arc=1.5mm,
    left=8pt,right=8pt,top=8pt,bottom=8pt,
    title={#1},
    fonttitle=\bfseries,
    coltitle=white,
    colbacktitle=UniPrimaryDeep
  ]%
}{%
  \end{tcolorbox}%
}

\NewDocumentCommand{\InterviewExchange}{m m}{%
  \stepcounter{interviewturn}%
  \par\medskip
  {\color{UniPrimaryDeep}\bfseries Pregunta \theinterviewturn. Lunabotics}\par
  #1\par\smallskip
  {\color{GoodGreen!70!black}\bfseries Carlos Pérez}\par
  #2\par
  \medskip{\color{UniPrimary!35}\hrule height 0.35pt}\medskip
}

